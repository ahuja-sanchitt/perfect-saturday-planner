# Required for the AI planner. Without it the app still works using the rule-based fallback planner.
OPENAI_API_KEY=

# Optional
# PLANNER_MODEL=gpt-5.4-mini          # override the model set in prompts/planner/<v>.md
# PARSER_MODEL=gpt-5.4-nano
# PROMPT_VERSION_OVERRIDE=planner=v1  # roll back / A-B a prompt version without a deploy
# RATE_LIMIT_PER_MIN=8                # per-IP plan requests per minute
# OSM_LIVE=1                          # top up the OSM snapshot with live Overpass queries (slow)
# FORCE_OSM_FAIL=1                    # demo: simulate OpenStreetMap being down
# FORCE_OSRM_FAIL=1                   # demo: simulate routing being down
